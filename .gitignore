# Артефакты генерации и локальные веса моделей
storage/output/
storage/tmp/
# Исходники, загруженные через панель: фотографии лиц — персональные данные
storage/input/
# Донорские фотографии для стендовых замеров сходства — тоже детская биометрия,
# и в репозиторий она не едет по той же причине. README внутри оставлен.
/donors/*
!/donors/README.txt
# Только корневой каталог: веса ml-service закрыты ml-service/.gitignore,
# который оставляет в репозитории models/.gitkeep
/models/
*.gguf
*.safetensors
*.bin

# Python-кэши (ml-service имеет свой .gitignore, но кэш появляется и в корне)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Локальные настройки Claude Code — машинозависимы
.claude/settings.local.json

# Локальные изображения для ручных прогонов face-swap: это персональные
