node_modules/
.env
.env.local
*.log
logs/
coverage/
dist/
build/

# Артефакты генерации и локальные веса моделей
storage/output/
storage/tmp/
# Исходники, загруженные через панель: фотографии лиц — персональные данные
storage/input/
# Донорские фотографии для стендовых замеров сходства — тоже детская биометрия,
# и в репозиторий она не едет по той же причине. README внутри оставлен.
/donors/*
!/donors/README.txt
# Только корневой каталог: веса ml-service закрыты ml-service/.gitignore,
# который оставляет в репозитории models/.gitkeep
/models/
*.gguf
*.safetensors
*.bin

# Python-кэши (ml-service имеет свой .gitignore, но кэш появляется и в корне)
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Локальные настройки Claude Code — машинозависимы
.claude/settings.local.json

# Локальные изображения для ручных прогонов face-swap: это персональные
# данные заказчиков, им не место в репозитории
/source.jpg
/target.png
/result*.jpg
/result*.png
/spread_*.png
/samples/

# Перечисление по именам не сработало: runner.py и ручные прогоны кладут в
# корень файлы с произвольными именами — «Без названия (2).jpeg», donor.jpg.jpeg,
# dino2.jpg.jpeg, cover8.png, SHEET_*.png, — и каждый такой файл виден в
# `git status` как невыслеженный, то есть уезжает в историю с первым же
# `git add -A`. В корне проекта изображений быть не должно вовсе: макеты лежат
# в public/, веса в models/. Поэтому запрет по расширению, а не по списку.
/*.jpg
/*.jpeg
/*.png
/*.webp

# Каталоги ручных прогонов (test_out, test_out_gaze, test_out_maxside1024, ...).
# Правила выше их не ловят: запрет по расширению стоит только на корень, а
# storage/ закрыт по своим путям. Внутри те же детские лица, что и в donors/,
# только нарезанные: donor_crop.png, donor_224_m1.8.png и готовые вклейки.
# Каталог целиком, а не по расширению: имена файлов там произвольные, и meta.json
# с geometry.json описывают ту же съёмку.
/test_out*/

# storage/ закрыт только по трём подкаталогам, а прогоны кладут файлы и в его
# корень (storage/dino1.jpg.jpeg, storage/Без названия.png)
/storage/*.jpg
/storage/*.jpeg
/storage/*.png
/storage/*.webp

# ОС / редакторы
.DS_Store
Thumbs.db
.idea/
.vscode/
