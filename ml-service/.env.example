# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Шаг 1: маска головы НА ШАБЛОНЕ (локально, mediapipe + OpenCV) ---
# Голова заказчика никуда не вырезается и не вклеивается: с фотографии берётся
# только лицо, и уезжает оно второй картинкой запроса.
#
# На РАБОЧЕЙ стратегии (face_swap) маска не строится вовсе: область эндпоинт
# находит своим детектором, а всё вне неё оставляет своим. Настройки ниже
# действуют только на диффузионных путях — там маска работает локально, по ней
# из ответа берётся одна голова и возвращается в шаблон.
#
# Семантическая разметка человека: лицо / волосы / кожа тела / одежда. По ней
# строится маска: класс «волосы» знает форму причёски персонажа, а сетка лица
# про волосы не знает ничего. ПУСТО — файл ищется в ~/.mediapipe или
# $MEDIAPIPE_HOME; без файла маска строится эллипсом по сетке лица — работает,
# но берёт голову с запасом. Скачать: см. app/pipelines/parsing.py
#
# Для ПРИЧЁСКИ (профиль pixar_hair) веса обязательны: форму волос знает только
# разметка, а запасное кольцо вокруг лица до длинных прядей не дотянется. Без
# файла /health/ready отдаёт degraded — но лишь когда выбран такой профиль
ML_PARSING_MODEL=

# Доли маски — от высоты лица персонажа. ПУСТО означает «взять из профиля»:
# маска и strength подбираются вместе. Числа здесь — для подбора на живом
# сервисе, без пересборки образа.
#
# dilate — расширение маски за контур головы. Маска впритык оставляет по краю
# контур старой причёски; чрезмерная — заставляет модель переписать плечи
ML_MASK_DILATE_RATIO=
# feather — растушёвка краёв. Жёсткий край даёт видимую границу генерации
ML_MASK_FEATHER_RATIO=
# neck — насколько маска опускается ниже подбородка. Там модель сводит новую
# голову с шеей и воротником; без запаса голова садится на чужую шею встык
ML_MASK_NECK_RATIO=

# --- Шаг 2: облачный инференс на fal.ai (ВЫКЛЮЧЕН) ---
# Наследство. Личность переносится своим Flux + PuLID на GPU-боксе, пересадка
# головы считается локально — стороннего платного сервиса для работы не нужно.
#
# false (умолчание) — ни один вызов до сети не доходит, ключ не читается, и
# готовность сервиса от fal не зависит: /health/ready отвечает 200 без ключа.
# Включать осознанно и только вместе с FAL_KEY и `pip install fal-client`.
ML_FAL_ENABLED=false

# Читается fal-client напрямую как FAL_KEY (без префикса ML_). При выключенном
# пути не читается вовсе — оставляйте пустым.
FAL_KEY=

ML_FAL_TIMEOUT_S=600

# Гиперпараметры генерации живут набором — профилем — в
# app/pipelines/refine/profiles.py, а не по одному здесь: strength, доли маски
# и вес идентичности подбираются вместе, и вразнобой они не имеют смысла.
# Ниже — выбор набора и точечные переопределения для подбора на живом сервисе.
#
#   pixar_real  фотореализм. Специализированный фейссвоп fal-ai/face-swap: лицо
#               переносится моделью, шаблон не трогается вовсе
#   pixar_hair  то же плюс ПРИЧЁСКА донора. Фейссвоп переносит только лицо, и
#               волосы остаются от шаблона; здесь перед ним идёт второй вызов —
#               редактор правит одни волосы, и в шаблон возвращается ровно они.
#               Стоит второго счёта и требует весов разметки: форму причёски
#               знает только она. Настройки — блок «шаг причёски» ниже
#   impasto     живопись: густой мазок, фактура холста. Остаётся на диффузии —
#               фейссвоп перенёс бы в картину фотографические пиксели, а лицо на
#               ней его детектор и не найдёт
ML_REFINE_PROFILE=pixar_real

# Переопределения профиля. Пустое значение — «взять из профиля»
ML_REFINE_ENDPOINT=
# Подход к переносу лица. Тянет за собой эндпоинт, схему запроса, текст
# инструкции и локальную работу: порознь они не имеют смысла, а перепутанные
# дают либо 422, либо молча испорченный кадр.
#
#   face_swap         рабочий. fal-ai/face-swap: специализированная модель лица,
#                     ни промпта, ни маски, ни локальной вклейки. Фотореализм
#                     переносится, а не выпрашивается словами
#   kontext_multi     редактор по двум картинкам (шаблон + фото массивом) плюс
#                     локальная вклейка головы. На kontext провалился — общая
#                     img2img не умеет хирургической замены лица по тексту, — но
#                     эндпоинт у него переключаемый, см. ниже
#   hair_swap         два вызова: редактор правит причёску, затем ТОТ ЖЕ
#                     face_swap переносит лицо. Порядок именно такой — диффузия
#                     идёт по нарисованной голове шаблона, а не по уже
#                     перенесённому фотографическому лицу
#   identity_inpaint  генерация внутри маски по фото-референсу. Провалился:
#                     под маской у модели нет контекста — искажённые пропорции,
#                     артефакты по краю и потеря личности
ML_REFINE_STRATEGY=
# Семейство схемы запроса. У эндпоинтов разные имена полей, и лишний ключ fal не
# игнорирует, а заворачивает весь запрос — рабочая схема принимает ровно
# base_image_url и swap_image_url. Обычно задавать не нужно: схему приносит
# ML_REFINE_STRATEGY.
#
#   face_swap       рабочая
#   kontext_multi   kontext/max/multi (провалился)
#   nano_banana     fal-ai/nano-banana/edit
#   seedream_edit   fal-ai/bytedance/seedream/v4/edit — единственный отдаёт 4K
#   hy_wu_edit      fal-ai/hy-wu-edit — заявлен именно для переноса лица
#   kontext_inpaint | flux_general — масочные
#
# Три средних — запасной путь стратегии kontext_multi для шаблонов, где голова
# персонажа стилизована и фотографические пиксели с ней не сойдутся. Схема у них
# общая, поэтому смена стоит двух переменных:
#   ML_REFINE_STRATEGY=kontext_multi
#   ML_REFINE_ENDPOINT=fal-ai/nano-banana/edit
#   ML_REFINE_PAYLOAD=nano_banana
ML_REFINE_PAYLOAD=
# Стиль сцены в промпте: pixar_real | impasto
ML_REFINE_STYLE=
# Описание сцены — дополнение к промпту стиля. Пусто: работает один стиль
ML_REFINE_SCENE=
# Ручки диффузии. На рабочей стратегии не действуют ни одна: фейссвоп ни
# strength, ни steps, ни guidance_scale не принимает — там нечего направлять.
#
# strength — только identity_inpaint. Под маской лежит голова ЧУЖОГО персонажа,
# и сохранять там нечего: рабочий диапазон 0.88-0.95. Ниже safe_strength профиля
# (0.85) в лог уходит warning — оттуда начинают проступать черты прежнего героя
ML_REFINE_STRENGTH=
ML_REFINE_STEPS=
# guidance_scale — обе диффузионные схемы. На kontext/max/multi это была
# единственная числовая ручка: выше — точнее по промпту, ниже — свободнее
ML_REFINE_GUIDANCE_SCALE=
# Где эндпоинт ждёт референс личности. У kontext/max/multi отдельного поля нет —
# фотография идёт вторым элементом image_urls, и эта ручка не действует. У
# kontext-inpaint это reference_image_url, у flux-general — ip_adapters
ML_REFINE_IDENTITY_FIELD=
# Насколько сильно тянуть черты с фотографии: выше — ближе к донору и дальше
# от стиля сцены. Работает только со схемами, где у референса есть свой вес
ML_REFINE_IDENTITY_SCALE=

# --- Шаг причёски: первый из двух вызовов стратегии hair_swap ---
# Действует только при ML_REFINE_PROFILE=pixar_hair (или ML_REFINE_STRATEGY=
# hair_swap). Ручки отдельные, потому что эндпоинт другой: ML_REFINE_ENDPOINT
# относится к замене лица и на причёску не влияет.
#
# Как это работает. Редактор получает ОКНО вокруг головы, текст — и больше
# ничего. Из ответа в шаблон возвращается ровно область причёски: лицо, фон и
# одежда остаются побитово исходными, — и уже на такой шаблон идёт обычный
# фейссвоп. Лицо под защитой маски не тронуто ни на пиксель: его ещё предстоит
# найти чужому детектору.
#
# ФОТОГРАФИЯ ЗАКАЗЧИКА НА ЭТОТ ШАГ НЕ ОТПРАВЛЯЕТСЯ. Универсальный редактор
# понимает портрет крупным планом не как «вот чья причёска», а как «вот что
# нарисовать»: и nano-banana, и seedream нарисовали лицо донора на затылке
# персонажа — в пустой области маски волос. Личность переносит фейссвоп вторым
# шагом, а причёска здесь описывается СЛОВАМИ (см. ML_HAIR_DESCRIPTION).
# Маску редактор тоже не получает: mask_url в его схеме нет, она работает
# локально, на вклейке.
#
# Редактор. Пусто — fal-ai/nano-banana/edit: точнее прочих держит остальной кадр
# и охотнее выполняет «убери», а не «поправь». Схема у всех трёх общая, поэтому
# смена стоит двух переменных:
#   ML_HAIR_ENDPOINT=fal-ai/bytedance/seedream/v4/edit  (единственный отдаёт 4K)
#   ML_HAIR_PAYLOAD=seedream_solo
#
# Схема только «одиночная»: nano_banana_solo | seedream_solo | hy_wu_solo. Она
# кладёт в массив один шаблон. Обычные (nano_banana, seedream_edit, hy_wu_edit)
# добавляют туда фотографию заказчика — это и есть второе лицо на затылке,
# поэтому такой профиль не собирается: 500 с внятным текстом до всякой сети
#
# Силы правки (strength, denoising_strength, image_guidance) у этих эндпоинтов
# НЕТ — проверено по openapi 2026-07-31: seedream принимает prompt, image_urls,
# image_size, seed, num_images, max_images, enhance_prompt_mode, sync_mode,
# enable_safety_checker, и ничего больше; nano-banana — prompt, image_urls,
# aspect_ratio, output_format, seed, num_images, safety_tolerance. Крутить в
# сторону «агрессивнее» тут нечего: правит промпт и то, что мы отправляем
ML_HAIR_ENDPOINT=
ML_HAIR_PAYLOAD=
# Причёска словами. ЕДИНСТВЕННЫЙ источник того, что рисовать на первом шаге:
# фотография туда не уезжает. Пусто здесь — описание обязано прийти в поле hair
# запроса; пусто и там — заказ отклоняется 400-й до всякой сети, потому что
# «замени причёску» без описания означает случайную причёску.
#
# Описывать надо ФИЗИКУ — миллиметры, просвечивающую кожу головы, край
# стрижки, — иначе «короткие» для модели означают просто «покороче прежних»:
# первый прогон сохранил объём старой причёски именно поэтому. Пример для
# светлого ёжика:
#
#   ML_HAIR_DESCRIPTION="The hair is a short blonde buzz cut, clipper-cut to a
#   few millimetres, the same length on top and at the sides, scalp clearly
#   visible through the stubble, sharp clipped hairline and sharp sideburn
#   edges, no fringe, no parting, no volume at the crown; the outline of the
#   head follows the skull."
#
# На конкретный заказ то же самое передаётся полем hair запроса
ML_HAIR_DESCRIPTION=
# Доли маски волос — от высоты лица персонажа. ПУСТО — из профиля (0.10 / 0.07)
#
# dilate — расширение за контур причёски. Там модель кладёт новую линию роста
# волос и затирает ореол старой; без запаса по краю остаётся тёмная кайма
ML_HAIR_DILATE_RATIO=
# feather — растушёвка края вклейки
ML_HAIR_FEATHER_RATIO=
# protect — поле защиты вокруг лица (0.05). Число между диффузией и глазами
# персонажа: под ним маска волос гаснет. Больше — безопаснее для лица и шире
# мягкий переход, но чёлка и виски остаются от шаблона; меньше — риск сглаженной
# кожи и того, что детектор фейссвопа лица не найдёт вовсе.
# Меняет ШИРИНУ поля, но не его форму: лоб защищён классом разметки при любом
# значении — за лоб отвечает следующая ручка.
#
# На волосы это поле больше не распространяется: пиксель, размеченный как
# волосы, идёт под правку, даже если лежит на щеке, — иначе защита спасала от
# стирания чёлку и бакенбарды, фейссвоп вклеивал лицо ПОД них, и на висках
# оставались ошмётки старого героя. Неприкосновенно только ядро лица (глаза,
# нос, рот). Проверять по мете: hair.hair_left_px — сколько волос осталось вне
# маски; проценты от hair_px означают, что ошмётки будут видны
ML_HAIR_PROTECT_RATIO=
# forehead — докуда маска спускается по лбу, в долях высоты лица НАД бровями.
# 0.5 и больше (умолчание) — лоб не трогается вовсе. 0 — маска доходит до самых
# бровей.
#
# Зачем опускать. Пока лоб защищён целиком, нижняя граница маски проходит по
# ОТКРЫТОЙ КОЖЕ, а вклейка геометрию не выравнивает (composite.py её только
# измеряет): сдвинувшаяся на несколько пикселей генерация превращает эту границу
# в рубец над бровями, и голова читается как накладка. Опущенная маска отдаёт
# лоб редактору целиком — полосы старой кожи между лицом от фейссвопа и новой
# причёской не остаётся, — а стык уходит в брови, под растушёвку самого
# фейссвопа. Рабочее значение против рубца: 0.05
#
# В мете смотреть hair.forehead_px: ноль при малом значении означает, что линия
# бровей посчитана мимо и рубец останется
ML_HAIR_FOREHEAD_RATIO=
# core — во сколько раз сжать ЯДРО ЛИЦА поперёк его оси. Ядро (выпуклая оболочка
# глаз, носа и рта) — единственное место, где защита сильнее волос: разметка,
# принявшая затенённое лицо за причёску, иначе пустила бы диффузию по глазам.
# 1.0 (умолчание) — как построено. 0.75 сильнее открывает виски и скулы: там
# застревают пряди, спускающиеся от виска к щеке, — оболочка кончается на
# внешнем углу глаза, а дилатация уводит её ещё на protect в сторону виска.
#
# Сжатие безопасно по устройству, а не по осторожности значения: дилатация ядра
# круговая и возвращает накрытие обратно наружу, поэтому сам угол глаза остаётся
# защищённым, пока сдвиг (1-core)×полуширина меньше поля protect×высота лица.
# При полуширине 90 px и protect 0.1 (30 px) это любое значение от 0.67
ML_HAIR_CORE_RATIO=
# guard — какую долю ПОЛУШИРИНЫ защиты лица оставить. 1.0 (умолчание) — всю.
#
# Против пряди, которую разметка отнесла к ЛИЦУ. Тонкий тёмный локон от виска к
# щеке сегментатор (он работает на 256x256) растворяет в классе FACE, и дальше
# прядь недостижима ни одним другим числом: в маску она не входит (для разметки
# она не волосы), гашение защиты волосами её не касается по той же причине, а
# вычитается она вместе с защитой — которая отнимается ПОСЛЕ дилатации. То есть
# расширять маску за такой прядью бесполезно: на щеке она умножится на ноль,
# сколько ни поднимай ML_HAIR_DILATE_RATIO. Сузить надо сам источник защиты.
#
# Полуширина берётся из самой защиты (максимальный поперечный вынос её
# пикселей), поэтому 1.0 по построению не режет ничего, а значение сравнимо
# между кадрами с разным поворотом головы. Рез идёт до расширения и размытия,
# как и срез по лбу: дилатация вернёт защиту через линию на protect обратно, и
# ступеньки посреди щеки не будет. Отсюда оценка: чтобы отпустить пиксель на
# расстоянии d от оси лица, нужно guard×полуширина + protect×высота лица < d —
# при полуширине 120 px и protect 0.08 (24 px) прядь на 90 px освобождает 0.55.
#
# Глаза, нос и рот этой ручкой не открываются: ядро лица возвращается поверх
# среза. Платим щеками и висками — они уходят под диффузию, поэтому смотреть в
# мете hair.protected_px (упал — защита сузилась) и на кожу щёк глазами.
#
# Угадывать не нужно: полуширина и поле защиты приезжают в мете как
# hair.guard_half_px и hair.protect_px, замеренные на этом самом кадре
ML_HAIR_GUARD_RATIO=
# cheek — докуда спускается полоса вдоль щеки, доли высоты лица НИЖЕ подбородка
# (0.35 — примерно до воротника). 0 отключает полосу.
#
# Третий, и последний, случай потерянной пряди — и единственный, где не помогает
# ничего из перечисленного выше. Локон от виска к щеке и дальше к воротнику
# разметка не относит НИ К ЧЕМУ: ни к волосам, ни к лицу. Для сегментатора
# (256x256) его там просто нет.
#
# Отсюда следует, что все числа выше до него не дотянутся по построению:
# ML_HAIR_DILATE_RATIO расширяет источник, которого нет, а GUARD и CORE только
# отпускают защиту, области не добавляя. И hair_left_px про такую прядь молчит —
# он меряет остаток КЛАССА волос, а класс её не знает: единицы пикселей в логе
# прекрасно уживаются с локоном во всю щёку.
#
# Полоса задаёт область геометрией, не спрашивая разметку: два прямоугольника в
# осях головы (то есть вместе с её наклоном) от виска вниз мимо челюсти к
# воротнику, поперёк — снаружи от внешних углов глаз и за ухо. Защиту лица она
# гасит наравне с настоящими волосами, иначе класс FACE вычел бы её обратно:
# защита отнимается ПОСЛЕ дилатации. Глаза, нос и рот не открываются ни при
# каком значении — поверх накладывается ядро лица.
#
# Платим щеками и шеей: они уходят под диффузию, и смотреть на них надо глазами.
# В мете три числа: hair.cheek_px (сколько накрыла полоса), hair.cheek_hair_px
# (сколько из этого разметка считала волосами — почти ноль подтверждает, что
# полоса тут единственный способ) и hair.cheek_open_px (сколько дошло до маски;
# заметно меньше cheek_px — полосу съела защита, и вот тогда крутить GUARD)
ML_HAIR_CHEEK_RATIO=
# erase — радиус размытия заливки, которой старая причёска стирается в кадре ДО
# отправки редактору. 0 (умолчание) — стирания нет.
#
# Провалившийся путь, оставленный переключателем. Гипотеза была в том, что
# редактор цепляется за структуру старых волос внутри открытой маски: область он
# не рисует с нуля, а переписывает присланные пиксели, и тёмная линия на светлой
# щеке для него — тень скулы. Живой прогон её опроверг и заодно доказал
# обратное: стирание залило мылом ВСЮ область, а прядь осталась резкой — значит,
# она лежала вне маски целиком, и разметка её не видит. Так и появился
# ML_HAIR_CHEEK_RATIO.
#
# Цена выяснилась тем же прогоном: вместе со структурой пропадает силуэт старой
# копны, и редактор рисует ёжик прямо по черепу — голова выходит лысой, — а
# границы заливки возвращают светлый ореол вокруг головы
ML_HAIR_ERASE_RATIO=
# crop — поле вокруг маски волос (1.0). Редактору уезжает ОКНО с головой, а не
# разворот целиком, и это не экономия трафика: на полном 4K причёска занимает
# проценты кадра, рабочий кадр редактора около мегапикселя, и на сотне пикселей
# волос он отдаёт мыльную шапку — стричь там нечего. Больше — больше контекста
# сцены (плечи, фон, свет) и меньше пикселей на волосы; меньше — наоборот, и
# растёт риск, что модель потеряет перспективу. 0 отправляет разворот целиком
ML_HAIR_CROP_RATIO=
# Порог «правка состоялась», уровни 0..255 внутри маски (3.0). Редактор умеет
# промолчать — вернуть кадр без изменений; ниже порога заказ отклоняется 422-й,
# не доходя до второго вызова
ML_HAIR_MIN_CHANGED=

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
