# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Устройство ---
# cpu | cuda | auto
ML_DEVICE=auto

# --- Модели ---
ML_MODELS_DIR=./models
ML_FACE_DETECTOR=buffalo_l
ML_FACE_SWAPPER=inswapper_128.onnx
ML_DET_SIZE=640

# Ленивая загрузка: веса читаются при первом запросе, а не на старте
ML_LAZY_LOAD=true

# --- Постобработка лица ---
# classical — согласование цвета, фактуры и резкости средствами OpenCV
# noop — без постобработки
ML_STYLE_PROVIDER=classical
ML_STYLE_COLOR=0.6
ML_STYLE_SMOOTH=0.5
ML_STYLE_GRAIN=0.7
ML_STYLE_SHARPNESS=0.6
ML_STYLE_MARGIN=1.8

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40
ML_MAX_FACES=10

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
