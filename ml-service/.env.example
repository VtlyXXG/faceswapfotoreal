# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Шаг 1: коллаж локально (OpenCV + mediapipe) ---
# Лицо переносится в шаблон преобразованием подобия и вклеивается ОРИГИНАЛЬНЫМИ
# пикселями фотографии — отсюда портретное сходство. Доли — от высоты лица.
#
# grow — запас контура вклейки за пределы лица. Без него у края может остаться
# бровь исходного персонажа, а при низком strength модель её уже не уберёт.
# Выше 0.03-0.04 начинает затягивать в кадр волосы и фон с фотографии
ML_COLLAGE_GROW_RATIO=0.02
# feather — растушёвка края вклейки. Коллаж намеренно жёсткий: ровно столько,
# чтобы убрать ступеньку антиалиасинга. Шов сводит второй шаг
ML_COLLAGE_FEATHER_RATIO=0.01
# colour_match — доля приведения тона вклейки к лицу шаблона (среднее и разброс
# по каналам LAB). Геометрию не трогает, снимает разницу между светом
# фотостудии и светом иллюстрации: при strength ~0.2 модель сама свести
# освещение не успевает. 0 — оставить цвет фотографии как есть
ML_COLLAGE_COLOUR_MATCH=0.8

# --- Шаг 2: облачный инференс на fal.ai ---
# Ключ читается fal-client напрямую как FAL_KEY (без префикса ML_)
FAL_KEY=

ML_FAL_TIMEOUT_S=600

# Инпейнтинг по маске MediaPipe поверх готового коллажа. Специализированные
# лицевые модели fal не подошли: easel-ai/advanced-face-swap ищет лицо своим
# детектором и на рисованных обложках его не находит, а flux-pulid и
# ip-adapter-face-id — чистый text-to-image без mask_url.
ML_FAL_MODEL=fal-ai/flux-kontext-lora/inpaint

# Промпт больше не просит нарисовать лицо — оно уже вклеено. Он запрещает
# трогать геометрию и описывает верхний слой: мазок, свет, исчезнувший шов.
# Отрицания идут прямо в текст: negative_prompt эндпоинт не берёт
ML_FAL_PROMPT=The face inside the masked area is a photograph collaged onto a painted illustration. Keep its geometry exactly as it is: the same features, the same proportions, the same position and size — do not redraw, move or reshape anything, this must stay the very same person. Change only the surface: convert the photographic skin into the medium of the surrounding artwork — the same brush strokes, canvas and paper grain, colour palette, line work and level of detail — match the direction and temperature of the light of the cover, and dissolve the collage seam so that no cut-out edge is left around the face. A hand-painted portrait that belongs to the cover art: no photographic skin texture, no visible pores, no visible seam or change of style at the jaw.

# strength — ГЛАВНАЯ ручка пайплайна: сила зашумления под маской. Под ней лежат
# оригинальные пиксели фотографии, и задача одна — не дать модели до них
# добраться. Рабочий диапазон 0.15–0.30: хватает на мазок, свет и сведение шва,
# но не на изменение черт. Выше ~0.35 геометрия плывёт (в лог уходит warning),
# ниже 0.15 мазок не набирается и шов остаётся виден
ML_FAL_STRENGTH=0.22
# guidance_scale — насколько строго исполняется промпт. Прежние 3.5 нужны были,
# чтобы перебороть фотофактуру референса; теперь фотография — основа кадра, а не
# соперник. На низком strength 2.5 даёт более чистый результат
ML_FAL_GUIDANCE_SCALE=2.5
# Реально исполняется лишь доля strength от шагов: 50 × 0.22 ≈ 11 шагов денойза.
# При 30-40 их остаётся 7-9, и переход в кольце растушёвки не успевает набраться
ML_FAL_STEPS=50

# --- Маска лица (mediapipe Face Mesh) ---
# Доли высоты лица, а не пиксели: обложки приходят и в 4K, и превью-размером.
# padding — сплошное поле вокруг контура, где модели разрешено вести переход;
# feather — ширина спада за ним. Спад лежит целиком снаружи лица, поэтому оно
# обрабатывается полностью, а с иллюстрацией сливается постепенно.
# Маска строится по объединению контуров лица шаблона и вклеенного коллажа
ML_MASK_PADDING_RATIO=0.06
ML_MASK_FEATHER_RATIO=0.10

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
