# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Шаг 1: фото-аппликация локально (rembg + OpenCV + mediapipe) ---
# Голова заказчика вырезается ЦЕЛИКОМ, с причёской, и вклеивается в шаблон
# ОРИГИНАЛЬНЫМИ пикселями — отсюда и портретное сходство, и родные волосы.
#
# Модели сегментации. Для фотографии человеческая: она аккуратнее ведёт край
# волос. Для обложки общая: нарисованный персонаж человеческой не всегда
# знаком. Веса качаются при первом запуске (~176 МБ на модель) в ~/.u2net или
# в $U2NET_HOME; поставьте оба значения одинаковыми, чтобы обойтись одной
# загрузкой. В Docker веса кладутся на этапе сборки образа
# Семантическая разметка человека: лицо / волосы / кожа тела / одежда. Нужна
# там, где цвет не отличает кожу от ткани — а он не отличает: бежевый жилет
# ближе к тону лица персонажа, чем его же рука. Пусто — файл ищется в
# ~/.mediapipe или $MEDIAPIPE_HOME; без файла сервис работает по прежним
# цветовым эвристикам. Скачать: см. app/pipelines/parsing.py
ML_PARSING_MODEL=

ML_SEG_MODEL_PHOTO=u2net_human_seg
ML_SEG_MODEL_COVER=u2net

# Область головы — эллипс по сетке лица, в долях размеров лица. Силуэт от
# сегментатора обрезается по ней: он знает, где кончаются волосы, но не знает,
# где кончается голова.
# hair — сколько высот лица (подбородок → брови) отложить ВВЕРХ от подбородка.
# 2.3 — канон (до макушки две) плюс запас на объём причёски. Мало — срежется
# верх волос, много — в кадр полезет фон
ML_HEAD_HAIR_RATIO=2.3
# neck — докуда опускается колонна шеи, доля высоты лица от подбородка. ПУСТО —
# искать линию одежды по цвету: от подбородка вниз идёт кожа, воротник — первое,
# что на неё не похоже. Шея нужна, чтобы голова не висела в воздухе и было где
# вести переход тона к телу персонажа. Число отключает поиск и режет вслепую
ML_HEAD_NECK_RATIO=
# width — ширина эллипса в долях ширины лица, запас на пышные причёски
ML_HEAD_WIDTH_RATIO=1.6
# По какой мерке считать масштаб. Все мерки лицевые, причёски нет ни в одной:
# umeyama — подгонка сразу по 18 опорным точкам лица (ближе всего к лицу
# шаблона), либо eyes / cheeks / jaw / face_height / median. Мерки спорят между
# собой до 25%: у рисованного персонажа глаза вдвое больше человеческих. Глаза
# дают самый КРУПНЫЙ масштаб, высота лица — самый мелкий; все значения видны в
# X-Swap-Meta как collage.scale_marks
ML_HEAD_SCALE_MARK=umeyama
# Художественный множитель размера головы. 1.0 — лицо донора точно совпадает с
# лицом персонажа (геометрически верно), но у мультяшной серии лицо занимает
# малую часть головы, а у фотографии большую, и это читается как большая голова
# на маленьком туловище. 0.85 заметно уменьшает голову, сохраняя пропорции
# самого лица. Подбирается на серию обложек, а не на заказ
ML_HEAD_SCALE_MULTIPLIER=1.0
# Опускать ли вклейку до воротника персонажа, если шея не дотянулась. Только
# вниз, только при реальном зазоре и только если воротник найден
# Брать ли шею донора. false — срез строго по челюсти: фотографичная шея на
# нарисованной груди читалась дешёвой аппликацией, спрятать этот стык нечем.
# Шею на обложке рисует заново инпейнтинг, отдельной зоной под подбородком
ML_HEAD_TAKE_NECK=false
# Опускать ли вклейку до воротника. Имеет смысл только вместе с TAKE_NECK:
# якорь сажал в воротник именно перенесённую шею
ML_HEAD_ANCHOR_NECK=false
# erode — на сколько подрезать край силуэта ВНУТРЬ, доля высоты лица. Граница
# rembg идёт по внешним пикселям волос, а они наполовину состоят из фона
# фотографии: без подрезки он переезжает на обложку каймой вокруг причёски.
# 0.006 — это 2-3 px на типичном портрете; много — объедаются тонкие пряди
ML_HEAD_ERODE_RATIO=0.006

# feather — растушёвка края аппликации. Коллаж намеренно жёсткий: ровно
# столько, чтобы убрать ступеньку антиалиасинга по контуру волос
ML_COLLAGE_FEATHER_RATIO=0.01
# colour_match — доля приведения тона КОЖИ к лицу шаблона (среднее и разброс по
# каналам LAB). Волос не касается: их цвет переносится ради того, чтобы он
# остался цветом заказчика. Геометрию не трогает, снимает разницу между светом
# фотостудии и светом иллюстрации — при strength 0.2 модель сама свести
# освещение не успевает. 0 — оставить цвет фотографии как есть
ML_COLLAGE_COLOUR_MATCH=0.8
# Стирать ли голову нарисованного персонажа из-под вклейки. Без этого у
# длинноволосого героя вокруг вклеенной головы остаётся его собственная
# шевелюра
ML_COLLAGE_ERASE_TEMPLATE_HEAD=true
# Чем затягивать её место: pyramid (заливка пирамидой — без штрихов и колец,
# на 4K в 13 раз быстрее) либо telea / ns из cv2.inpaint
ML_COLLAGE_ERASE_METHOD=pyramid
# Докуда стирать голову персонажа. ПУСТО — до его линии одежды: стирается и
# нарисованная шея, чтобы шея донора села прямо в воротник. Шов на горле
# заметнее, чем стык по линии одежды, — там его прячут воротник и плечи
ML_COLLAGE_ERASE_NECK_RATIO=
# Куда подтягивать тон кожи. to_donor — тело персонажа под вклейку (голова
# остаётся реалистичной), to_template — вклейку под персонажа
ML_COLLAGE_COLOUR_DIRECTION=to_donor
# Радиус подкраски тела персонажа, в высотах его лица от низа вклейки. Не
# «сколько нужно», а «докуда безопасно»: отличить кожу от бежевой одежды и
# декораций по цвету на этих обложках нельзя, см. README. 0 — не трогать тело
ML_COLLAGE_BODY_REACH=1.2
# Запас вокруг силуэта персонажа: по краю рисованных волос идёт полупрозрачная
# кромка, впритык она остаётся тёмной каймой
ML_COLLAGE_ERASE_PAD_RATIO=0.03

# --- Шаг 2: облачный инференс на fal.ai ---
# Ключ читается fal-client напрямую как FAL_KEY (без префикса ML_)
FAL_KEY=

ML_FAL_TIMEOUT_S=600

# Гиперпараметры второго шага живут набором — профилем — в
# app/pipelines/refine/profiles.py, а не по одному здесь: strength, ширина
# градиента маски и веса ControlNet подбираются вместе, и вразнобой они не
# имеют смысла. Ниже — выбор набора и точечные переопределения для подбора на
# живом сервисе.
#
#   seam               strength 0.20, маска-плато по стыку. Режим, на котором
#                      пайплайн работал до сих пор
#   blend              РАБОЧИЙ: strength 0.26, градиентная маска. Шея и контур
#                      волос сводятся мягко, но геометрия причёски не плывёт —
#                      выше ~0.28 она едет, и без ControlNet держать её нечем.
#                      Остаётся на kontext-inpaint, где висит наша LoRA
#   stylise            strength 0.50, та же маска. Настоящая стилизация, но БЕЗ
#                      КАРТ рискует контуром причёски
#   stylise_controlnet то же плюс карты Canny и Depth. ТРЕБУЕТ эндпоинта,
#                      принимающего ControlNet: kontext-inpaint его не берёт, а
#                      лишний ключ заворачивает весь запрос. Уход на другой
#                      эндпоинт означает потерю стиля нашей LoRA
ML_REFINE_PROFILE=blend

# Переопределения профиля. Пустое значение — «взять из профиля»
ML_REFINE_ENDPOINT=
ML_REFINE_STRATEGY=
ML_REFINE_PROMPT=
# strength — ГЛАВНАЯ ручка: сила зашумления под маской. 0.15-0.25 — только шов,
# 0.25-0.28 — рабочий диапазон с градиентной маской, 0.45-0.55 — стилизация с
# перерисовкой, но она требует ControlNet. Выше safe_strength профиля в лог
# уходит warning: там начинает плыть контур причёски
ML_REFINE_STRENGTH=
ML_REFINE_GUIDANCE_SCALE=
ML_REFINE_STEPS=
# Ширина градиента маски, доля высоты лица. На высоком strength маска-плато
# даёт видимую ступеньку по своей границе
ML_REFINE_GRADIENT_RATIO=
# Какие карты ControlNet оставить: «canny,depth» или «none». Веса и пороги
# остаются из профиля
ML_REFINE_CONTROLS=

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
