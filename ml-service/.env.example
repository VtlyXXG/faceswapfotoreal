# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Замена лица: облачный инференс на fal.ai ---
# Ключ читается fal-client напрямую как FAL_KEY (без префикса ML_)
FAL_KEY=

ML_FAL_TIMEOUT_S=600

# Инпейнтинг по маске MediaPipe: личность задаётся референсом, стиль обложки —
# промптом. Специализированные лицевые модели fal не подошли: easel-ai/
# advanced-face-swap ищет лицо своим детектором и на рисованных обложках его не
# находит, а flux-pulid и ip-adapter-face-id — чистый text-to-image без mask_url.
ML_FAL_MODEL=fal-ai/flux-kontext-lora/inpaint

# Промпт формулирует задачу — перерисовать лицо в манере обложки, а не вставить
# фотографию, — и перечисляет нежелательное: negative_prompt эндпоинт не берёт
ML_FAL_PROMPT=Repaint the face inside the masked area so that it belongs to this artwork. Keep the identity, facial features and proportions of the reference person, but render them entirely in the medium of the surrounding illustration: the same brush strokes, canvas and paper grain, colour palette, line work, level of detail and direction of light. Hand-painted and seamlessly blended into the cover art, not a photograph pasted on top: no photographic skin texture, no visible pores, no cut-out edge or seam around the face, no change of style at the jaw.

# Баланс «личность ↔ стиль», подбирается глазами под конкретную обложку.
# strength — сила зашумления под маской. Дефолт эндпоинта 0.88 перерисовывает
# область почти с нуля; 0.82 оставляет живопись обложки подложкой. Ниже ~0.7
# начинает проступать исходное лицо
ML_FAL_STRENGTH=0.82
# guidance_scale — насколько строго исполняется промпт. Дефолт эндпоинта 2.5
# оставляет референсу слишком много воли, и его фотофактура течёт в результат;
# 3.5 — верх рабочего диапазона Flux, за 4.0 картинка начинает «гореть»
ML_FAL_GUIDANCE_SCALE=3.5
# Больше дефолтных 30: переход в кольце растушёвки набирается на последних шагах
ML_FAL_STEPS=40

# --- Маска лица (mediapipe Face Mesh) ---
# Доли высоты лица, а не пиксели: обложки приходят и в 4K, и превью-размером.
# padding — сплошное поле вокруг контура, где модели разрешено вести переход;
# feather — ширина спада за ним. Спад лежит целиком снаружи лица, поэтому оно
# перерисовывается полностью, а с иллюстрацией сливается постепенно
ML_MASK_PADDING_RATIO=0.06
ML_MASK_FEATHER_RATIO=0.10

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40
ML_MAX_FACES=10

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
