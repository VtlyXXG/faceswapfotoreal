# --- Сервис ---
ML_HOST=0.0.0.0
ML_PORT=8000
ML_LOG_LEVEL=info

# --- Логи ---
# В файлы всегда пишется JSON; ML_LOG_JSON=true включает JSON и в консоль
ML_LOG_DIR=./logs
ML_LOG_FILE=app.log
ML_LOG_ERROR_FILE=error.log
# Ротация: midnight | H | D (когда) + досрочно по размеру
ML_LOG_ROTATE_WHEN=midnight
ML_LOG_FILE_MAX_MB=20
ML_LOG_BACKUP_COUNT=14
ML_LOG_JSON=false
ML_ENV=development

# --- Замена лица: облачный инференс на fal.ai ---
# Ключ читается fal-client напрямую как FAL_KEY (без префикса ML_)
FAL_KEY=

ML_FAL_TIMEOUT_S=600

# Какой бэкенд обслуживает замену лица: kontext | faceswap.
# Связки «identity-модель + инпейнтинг по маске» на fal нет — flux-pulid и
# ip-adapter-face-id это чистый text-to-image, — поэтому два разных подхода:
#   kontext  — инпейнтинг по маске MediaPipe, личность задаётся референсом.
#              Держит стиль обложки промптом, но модель общего назначения.
#   faceswap — специализированный перенос лица. Маска не строится, волосы
#              обложки сохраняет сам. Промпта нет — тяготеет к фотореализму.
ML_FAL_BACKEND=kontext

# --- Бэкенд kontext ---
ML_FAL_KONTEXT_MODEL=fal-ai/flux-kontext-lora/inpaint
# Промпт держит стиль иллюстрации: модель дорисовывает лицо в её манере.
# negative_prompt эндпоинт не принимает
ML_FAL_PROMPT=A portrait of a person, matching the exact artistic style, brushstrokes, and lighting of the surrounding image
# Дефолт эндпоинта 0.88 — этой модели подходят высокие значения
ML_FAL_STRENGTH=0.88
# Дефолт эндпоинта 2.5, заметно ниже привычных для SD 7.5
ML_FAL_GUIDANCE_SCALE=2.5
ML_FAL_STEPS=30

# --- Бэкенд faceswap ---
ML_FAL_FACESWAP_MODEL=easel-ai/advanced-face-swap
# target_hair сохраняет причёску обложки, user_hair — причёску заказчика
ML_FAL_FACESWAP_WORKFLOW=target_hair
ML_FAL_FACESWAP_UPSCALE=true
# Пол донора приходит из заказа полем donor_gender; это дефолт, когда не передан
ML_FAL_FACESWAP_DEFAULT_GENDER=non-binary

# --- Маска лица (mediapipe Face Mesh) ---
# Используется только бэкендом kontext.
# Сильное размытие даёт бесшовный переход; приводится к нечётному
ML_MASK_BLUR_KERNEL=101

# --- Лимиты ---
# Обложки в 4K занимают 25-30 МБ, поэтому лимит выше типового
ML_MAX_UPLOAD_MB=40
ML_MAX_FACES=10

# --- Интеграция с Node.js API ---
ML_ALLOWED_ORIGINS=http://localhost:3000
