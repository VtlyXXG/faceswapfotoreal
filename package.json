{
  "name": "projectx-book-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервис генерации кастомизированных книг с использованием локальных ИИ-моделей",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src tests",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "bullmq": "^5.13.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-roll": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3"
  }
}
