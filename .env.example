# --- Приложение ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Логи ---
# JSON-логи пишутся в файлы всегда; в консоль — pretty в dev и JSON в production
LOG_DIR=./logs
# Базовые имена без расширения: pino-roll даст app.2026-07-23.1.log
LOG_FILE=app
LOG_ERROR_FILE=error

# Ротация: daily | hourly | число мс; size — досрочная ротация по объёму
LOG_ROTATE_FREQUENCY=daily
LOG_ROTATE_SIZE=20m
LOG_ROTATE_LIMIT=14
LOG_ROTATE_DATE_FORMAT=yyyy-MM-dd

# --- ML-микросервис (FastAPI) ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=180000

# --- Хранилище ---
STORAGE_DRIVER=fs
STORAGE_ROOT=./storage

# --- Очередь задач генерации ---
QUEUE_DRIVER=memory
QUEUE_CONCURRENCY=2

# --- Текстовая ИИ-модель (локальная) ---
# Поддерживаемые провайдеры: ollama | llamacpp | mock
AI_TEXT_PROVIDER=ollama
AI_TEXT_BASE_URL=http://127.0.0.1:11434
AI_TEXT_MODEL=llama3.1:8b
AI_TEXT_TIMEOUT_MS=120000
AI_TEXT_MAX_TOKENS=2048
AI_TEXT_TEMPERATURE=0.8

# --- Модель генерации изображений (локальная) ---
# Поддерживаемые провайдеры: automatic1111 | comfyui | mock
AI_IMAGE_PROVIDER=mock
AI_IMAGE_BASE_URL=http://127.0.0.1:7860
AI_IMAGE_MODEL=sd-xl-base-1.0
AI_IMAGE_TIMEOUT_MS=180000
AI_IMAGE_WIDTH=1024
AI_IMAGE_HEIGHT=1024
