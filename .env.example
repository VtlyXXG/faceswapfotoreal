# --- Приложение ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# --- Логи ---
# JSON-логи пишутся в файлы всегда; в консоль — pretty в dev и JSON в production
LOG_DIR=./logs
# Базовые имена без расширения: pino-roll даст app.2026-07-23.1.log
LOG_FILE=app
LOG_ERROR_FILE=error

# Ротация: daily | hourly | число мс; size — досрочная ротация по объёму
LOG_ROTATE_FREQUENCY=daily
LOG_ROTATE_SIZE=20m
LOG_ROTATE_LIMIT=14
LOG_ROTATE_DATE_FORMAT=yyyy-MM-dd

# --- ML-микросервис (FastAPI) ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=180000
# face-swap с диффузией долгий; ждёт воркер, не клиент
ML_FACE_SWAP_TIMEOUT_MS=600000

# --- Хранилище файлов (исходники и готовые обложки) ---
STORAGE_DRIVER=fs
STORAGE_ROOT=./storage

# --- Хранилище заказов ---
# memory — in-process (по умолчанию); postgres — общее состояние между
# процессами API и воркеров, переживает перезапуск (полная автономность)
DB_DRIVER=memory
DATABASE_URL=postgres://127.0.0.1:5432/projectx
DB_TABLE=covers
DB_SSL=false

# --- Очередь задач ---
# memory — in-process, без инфраструктуры (по умолчанию)
# redis  — BullMQ: durable, воркеры масштабируются отдельно от API
QUEUE_DRIVER=memory
# Выполняет ли процесс API задачи. false — жёсткое разделение ролей: API только
# принимает запросы и отдаёт 202, работу делают воркеры (npm run worker).
# Осмысленно только с QUEUE_DRIVER=redis
WORKER_IN_API=true
QUEUE_CONCURRENCY=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
# Действует при QUEUE_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=projectx
QUEUE_NAME=tasks
