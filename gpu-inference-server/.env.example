# Конфигурация gpu-inference-server. Скопировать в .env РЯДОМ С Dockerfile на
# сервере и передать в docker run через --env-file.
#
#     cp .env.example .env && nano .env
#     docker run ... --env-file .env ...
#
# Через -e VAR="..." в командной строке — не надо: подстановка плейсхолдера
# руками уже стоила часа отладки. Файл переживает перезапуск и виден целиком.
#
# ВНИМАНИЕ, АУТЕНТИФИКАЦИИ У СЕРВЕРА НЕТ. В server.py нет ни проверки токена,
# ни заголовка, ни зависимости FastAPI — любой, кто дотянулся до порта,
# запускает генерацию. Переменной вида API_TOKEN здесь нет не по забывчивости:
# читать её некому. Единственная защита — публикация порта на петлю
# (-p 127.0.0.1:8100:8100) и SSH-туннель до ml-service. Не выставляйте 0.0.0.0.

# --- Карта --------------------------------------------------------------------
GPU_DEVICE=cuda
GPU_DTYPE=float16

# Длинная сторона рабочего кадра диффузии. Дефолт кода — 1024, он выставлен под
# карту на 48 ГБ. На 3090 (24 ГБ) при загруженных SDXL + ControlNet +
# IP-Adapter + LaMa + CodeFormer пик на 1024 подходит к границе, поэтому 896.
# Поднимать до 1024 — только после того, как увидите реальный пик в nvidia-smi.
GPU_MAX_SIDE=896
GPU_MIN_SIDE=512

# Освобождать кэш аллокатора после кадра. В коде выключено по умолчанию с
# оговоркой «на 48 ГБ фрагментация не набирается». На 24 ГБ она набирается,
# поэтому включено: десятки миллисекунд на кадр против OOM на длинной смене.
GPU_EMPTY_CACHE=1

# --- Диффузия -----------------------------------------------------------------
GPU_STEPS=30
GPU_GUIDANCE_SCALE=7.0
GPU_STRENGTH=0.92
GPU_CONTROL_SCALE=0.55

# --- Перенос личности (IP-Adapter Plus Face) ----------------------------------
GPU_IP_ADAPTER=1
# 0.65 — отправная точка, не измеренный оптимум. Выше ~0.8 адаптер перебивает
# позу от ControlNet и разворачивает голову к анфасу донора.
GPU_IP_ADAPTER_SCALE=0.65

# --- Остальные шаги -----------------------------------------------------------
GPU_ERASE=1
GPU_RESTORE_FACE=1
GPU_CODEFORMER_W=0.7

# --- Очередь ------------------------------------------------------------------
# Слот один: карта одна. Менять только на нескольких картах.
GPU_QUEUE_SLOTS=1
GPU_QUEUE_MAX_WAITING=8
# Ожидание слота. Потолок задан НЕ здесь: ожидание и рендер идут в одном
# HTTP-запросе, а прокси автозапуска рвёт соединение на 900 с. 600 + 167
# (обложка, самая дорогая страница) = 767. Поднимать — только вместе с прокси.
GPU_QUEUE_WAIT_TIMEOUT=600

# --- Служебное ----------------------------------------------------------------
GPU_WARMUP=1
GPU_LOG_LEVEL=INFO
