# Веса скачиваются ВНУТРИ образа манифестом, а не копируются с машины сборки:
# каталог локальной разработки весит десятки гигабайт, и отправка его в
# контекст сборки — это минуты ожидания до первой инструкции.
weights/
*.pt
*.pth
*.onnx
*.safetensors
*.bin

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Настройки конкретной машины: в образ едут переменные из --env-file на
# сервере, а не отсюда
.env
.env.*
!.env.example

# Сборочный скрипт для «голого» инстанса без докера — в образе не нужен
setup_server.sh

*.md
*.log
.git/
.gitignore
